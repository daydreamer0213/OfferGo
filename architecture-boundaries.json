{
  "version": 1,
  "dependencyRules": [
    {
      "id": "core-outward",
      "from": [
        "core/**"
      ],
      "deny": [
        "application/**",
        "adapters/**",
        "dashboard/**",
        "storage/**"
      ]
    },
    {
      "id": "application-presentation",
      "from": [
        "application/**"
      ],
      "deny": [
        "dashboard/**"
      ]
    },
    {
      "id": "application-adapters",
      "from": [
        "application/**"
      ],
      "deny": [
        "adapters/**"
      ]
    },
    {
      "id": "dashboard-storage",
      "from": [
        "dashboard/**"
      ],
      "deny": [
        "storage/**",
        "core/storage.js"
      ]
    },
    {
      "id": "dashboard-adapters",
      "from": [
        "dashboard/pages/**",
        "dashboard/view_models/**",
        "dashboard/*controller.js"
      ],
      "deny": [
        "adapters/**"
      ]
    },
    {
      "id": "commands-infrastructure",
      "from": [
        "commands/**"
      ],
      "deny": [
        "storage/**",
        "adapters/**",
        "core/storage.js"
      ]
    }
  ],
  "patternRules": [
    {
      "id": "dashboard-direct-sql",
      "files": [
        "dashboard/**"
      ],
      "pattern": "\\bdb\\.prepare\\s*\\("
    },
    {
      "id": "application-direct-sql",
      "files": [
        "application/**"
      ],
      "pattern": "\\bdb\\.prepare\\s*\\("
    }
  ],
