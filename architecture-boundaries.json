{
  "version": 1,
  "dependencyRules": [
    {
      "id": "core-outward",
      "from": [
        "core/**"
      ],
      "deny": [
        "application/**",
        "adapters/**",
        "dashboard/**",
        "storage/**"
      ]
    },
    {
      "id": "application-presentation",
      "from": [
        "application/**"
      ],
      "deny": [
        "dashboard/**"
      ]
    },
    {
      "id": "application-adapters",
      "from": [
        "application/**"
      ],
      "deny": [
        "adapters/**"
      ]
    },
    {
      "id": "dashboard-storage",
      "from": [
        "dashboard/**"
      ],
      "deny": [
        "storage/**",
        "core/storage.js"
      ]
    },
    {
      "id": "dashboard-adapters",
      "from": [
        "dashboard/pages/**",
        "dashboard/view_models/**",
        "dashboard/*controller.js"
      ],
      "deny": [
        "adapters/**"
      ]
    },
    {
      "id": "commands-infrastructure",
      "from": [
        "commands/**"
      ],
      "deny": [
        "storage/**",
        "adapters/**",
        "core/storage.js"
      ]
    }
  ],
  "patternRules": [
    {
      "id": "dashboard-direct-sql",
      "files": [
        "dashboard/**"
      ],
      "pattern": "\\bdb\\.prepare\\s*\\("
    },
    {
      "id": "application-direct-sql",
      "files": [
        "application/**"
      ],
      "pattern": "\\bdb\\.prepare\\s*\\("
    }
  ],
  "exceptions": [
    "dependency:application-adapters:application/onboarding/initial_search_page.js -> adapters/sites/boss.js",
    "dependency:core-outward:core/candidate_progress.js -> storage/funnel_store.js",
    "dependency:core-outward:core/candidate_progress.js -> storage/storage_shared.js",
    "dependency:core-outward:core/communication_ambiguity.js -> storage/communication_store.js",
    "dependency:core-outward:core/communication_batches.js -> storage/communication_store.js",
    "dependency:core-outward:core/llm_analyzer.js -> adapters/models/index.js",
    "dependency:core-outward:core/message_discovery.js -> adapters/sites/boss_message_dom.js",
    "dependency:core-outward:core/message_discovery.js -> application/message_draft_quality/index.js",
    "dependency:core-outward:core/message_preview_state.js -> storage/scan_store.js",
    "dependency:core-outward:core/onboarding_run.js -> application/onboarding/run.js",
    "dependency:core-outward:core/scan_snapshot.js -> adapters/sites/boss.js",
    "dependency:core-outward:core/storage.js -> storage/candidate_store.js",
    "dependency:core-outward:core/storage.js -> storage/database.js",
    "dependency:core-outward:core/storage.js -> storage/funnel_store.js",
    "dependency:core-outward:core/storage.js -> storage/job_store.js",
    "dependency:core-outward:core/storage.js -> storage/message_learning_store.js",
    "dependency:core-outward:core/storage.js -> storage/message_timeline_store.js",
    "dependency:core-outward:core/storage.js -> storage/message_reply_send_store.js",
    "dependency:core-outward:core/storage.js -> storage/migrations.js",
    "dependency:core-outward:core/storage.js -> storage/mock_interview_store.js",
    "dependency:core-outward:core/storage.js -> storage/resume_optimization_store.js",
    "dependency:core-outward:core/storage.js -> storage/scan_store.js",
    "dependency:core-outward:core/storage.js -> storage/schema.js",
    "dependency:core-outward:core/storage.js -> storage/storage_shared.js",
    "dependency:core-outward:core/storage.js -> storage/workflow_store.js",
    "dependency:core-outward:core/storage.js -> storage/workspace_platform_store.js",
    "dependency:dashboard-adapters:dashboard/message_discovery_controller.js -> adapters/models/index.js",
    "dependency:dashboard-adapters:dashboard/message_discovery_controller.js -> adapters/sites/boss.js",
    "dependency:dashboard-adapters:dashboard/message_discovery_controller.js -> adapters/sites/boss_message_detail_reader.js",
    "dependency:dashboard-adapters:dashboard/message_discovery_controller.js -> adapters/sites/boss_message_reader.js",
    "dependency:dashboard-adapters:dashboard/message_discovery_controller.js -> adapters/sites/zhaopin_message_detail_reader.js",
    "dependency:dashboard-adapters:dashboard/message_discovery_controller.js -> adapters/sites/zhaopin_message_reader.js",
    "dependency:dashboard-adapters:dashboard/message_follow_up_controller.js -> adapters/sites/boss_message_reader.js",
    "dependency:dashboard-adapters:dashboard/message_reply_send_controller.js -> adapters/sites/boss_message_reader.js",
    "dependency:dashboard-adapters:dashboard/message_reply_send_controller.js -> adapters/sites/boss_message_reply_sender.js",
    "dependency:dashboard-adapters:dashboard/message_reply_send_controller.js -> adapters/sites/zhaopin_message_reader.js",
    "dependency:dashboard-adapters:dashboard/message_reply_send_controller.js -> adapters/sites/zhaopin_message_reply_sender.js",
    "dependency:dashboard-storage:dashboard/message_discovery_controller.js -> core/storage.js",
    "dependency:dashboard-storage:dashboard/message_follow_up_controller.js -> core/storage.js",
    "dependency:dashboard-storage:dashboard/message_reply_send_controller.js -> core/storage.js",
    "dependency:dashboard-storage:dashboard/message_action_controller.js -> core/storage.js",
    "dependency:dashboard-storage:dashboard/server.js -> core/storage.js",
    "dependency:dashboard-storage:dashboard/server.js -> storage/onboarding_store.js",
    "dependency:dashboard-storage:dashboard/server.js -> storage/platform_search_context_store.js"
  ]
}
